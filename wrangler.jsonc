{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "progressive-life",
  "main": "src/index.js",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "VOICE_BUCKET",
      "bucket_name": "progressive-life-voice"
    }
  ],
  "observability": {
    "enabled": true
  }
}